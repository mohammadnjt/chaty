# Copy to server/.env. Features, calls/TURN, storage and sign-up approval are
# managed from the admin panel (saved in files/settings.json).

ADMIN_PHONE=0912xxxxxxx
ADMIN_PASSWORD=change-me

PORT=8080
# DATA_DIR=../files
# DOMAIN=chat.example.com
# HTTPS=self

# Seeds for the first settings.json (afterwards use the admin panel):
# TURN_PUBLIC_IP=203.0.113.10
# TURN_PORT=3478
# TURN_RELAY_PORTS=49160-49200

# Emergency override if the database in settings.json is unreachable:
# STORAGE_DRIVER=file
# STORAGE_DSN=
